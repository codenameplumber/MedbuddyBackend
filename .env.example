APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────────────
# Two providers, one active at a time. Swapping is a comment, not a code
# change: everything sends through Laravel Notifications either way.
#
# ACTIVE: Mailtrap sandbox. Real SMTP, but every message is trapped in one
# inbox instead of reaching a patient — which is what you want while the
# cohort is 120 fabricated people on a .test domain.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=reminders@medbuddy.test
MAIL_FROM_NAME=MedBuddy

# ── Resend — for when mail should really leave the building ───────────
# Uncomment ONE of the two blocks below and comment out the Mailtrap block
# above. Then: php artisan config:clear && php artisan medbuddy:mail-test you@you.com
#
# Option A — SMTP. No extra package, nothing to install.
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=re_xxxxxxxxxxxx      <- your Resend API key goes here
#   MAIL_FROM_ADDRESS=reminders@yourdomain.com
#   MAIL_FROM_NAME=MedBuddy
#
# Option B — Resend's API driver. Better delivery reporting and webhooks,
# but needs: composer require resend/resend-laravel
#   MAIL_MAILER=resend
#   RESEND_API_KEY=re_xxxxxxxxxxxx
#   MAIL_FROM_ADDRESS=reminders@yourdomain.com
#   MAIL_FROM_NAME=MedBuddy
#
# Either way the from-domain must be verified in Resend first, or every
# send is rejected. A .test address will not work in production.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── MedBuddy ─────────────────────────────────────────────────────────
# Dose windows are wall-clock local times. Leaving this at UTC makes every
# Nigerian reminder fire an hour late.
APP_TIMEZONE=Africa/Lagos

# ── Demo sign-in ─────────────────────────────────────────────────────
# The patient app has no passwords, which makes it awkward to show someone.
# With this on, /me/login lists the seeded cohort and one tap signs you in.
#
# It is a deliberate authentication bypass. It only ever offers patients on
# the fabricated @patient.medbuddy.test domain and refuses anything else, but
# turn it off before a real patient is enrolled. `medbuddy:doctor` says so
# loudly while it is on.
MEDBUDDY_DEMO_SIGNIN=true

# ── AI engine ────────────────────────────────────────────────────────
# OpenAI answers by default. Claude stays wired behind the same interface —
# switch with the line below plus its key, then: php artisan config:clear
#
#   openai     → GPT, via openai-php/client
#   anthropic  → Claude, via anthropic-ai/sdk
MEDBUDDY_AI_PROVIDER=openai
MEDBUDDY_AI_MODE=live

# OpenAI — the active provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1600

# Anthropic — kept configured, not currently selected
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=4000

# With MEDBUDDY_AI_MODE=mock — or with no key for the selected provider —
# every screen still works on canned answers. That is deliberate: a demo
# should not depend on a venue's wifi.
