APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────────────
# Mailtrap sandbox for the pilot: every reminder is really sent over SMTP and
# lands in one inbox instead of a patient's. Credentials are per-inbox — copy
# them from Mailtrap > Inboxes > SMTP Settings > Laravel 9+.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=reminders@medbuddy.test
MAIL_FROM_NAME=MedBuddy

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── MedBuddy ─────────────────────────────────────────────────────────
# Dose windows are wall-clock local times. Leaving this at UTC makes every
# Nigerian reminder fire an hour late.
APP_TIMEZONE=Africa/Lagos

# AI. 'mock' needs no key and keeps every screen demoable offline; 'live'
# calls Claude from the server. The key stays here and never reaches a browser.
MEDBUDDY_AI_MODE=live
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Reasoning depth per call: low | medium | high | xhigh | max.
# 'medium' is the balance a patient holding a phone actually wants.
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=4000
